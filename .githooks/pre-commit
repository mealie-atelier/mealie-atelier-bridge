#!/bin/sh
# Local quality gate. GitHub Actions are intentionally disabled for this organization.
set -e
if git diff --cached --name-only | grep -qiE '(^|/)(CLAUDE(\.local)?\.md|\.claude/|\.mcp\.json|AGENTS\.md)'; then
  echo 'AI assistant files must not be committed.' >&2; exit 1
fi
uv run --frozen ruff check
uv run --frozen ruff format --check
uv run --frozen pytest -q
